5:21:20 PM [express] GET /api/questions 200 in 37ms :: {"questions":[{"id":1,"text":"What's the one value you'd never compromise on, even if it cost you a relationship?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":3,"orderIndex":1},{"id":2,"text":"How do you define integrity in your daily life?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":2},{"id":3,"text":"What does loyalty look like to you in a romantic relationship?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":3,"orderIndex":3},{"id":4,"text":"If you had to choose between financial security and doing work you love, which would you pick and why?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":4},{"id":5,"text":"How important is honesty to you, even when the truth might hurt?","category":"values","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":3,"orderIndex":5},{"id":6,"text":"What causes or social issues do you feel most passionate about?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":6},{"id":7,"text":"How do you feel about giving back to your community or volunteering?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":7},{"id":8,"text":"What role does faith or spirituality play in your life?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":8},{"id":9,"text":"How do you handle situations where your values conflict with someone you care about?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":9},{"id":10,"text":"What did your upbringing teach you about what matters most in life?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":10},{"id":11,"text":"How important is environmental consciousness in your daily choices?","category":"values","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":11},{"id":12,"text":"What's a belief you held strongly that changed as you got older?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":12},{"id":13,"text":"How do you feel about keeping promises, even small ones?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":13},{"id":14,"text":"What does success mean to you beyond money and career?","category":"values","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":14},{"id":15,"text":"If your partner had a very different political worldview, would that be a deal-breaker?","category":"values","answerType":"multiple_choice","options":["Absolute deal-breaker","Depends on the specific issues","I'd be open to it","I actually prefer different perspectives"],"isOnboardingQuestion":false,"weight":2,"orderIndex":15},{"id":16,"text":"What's the most important lesson a past relationship taught you?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":3,"orderIndex":16},{"id":17,"text":"What does your ideal relationship look like on a random Tuesday evening?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":2,"orderIndex":17},{"id":18,"text":"How much personal space do you need in a relationship?","category":"relationships","answerType":"multiple_choice","options":["A lot - I need plenty of alone time","A healthy amount - some nights apart are good","Not much - I love being around my partner","It depends on the phase of the relationship"],"isOnboardingQuestion":false,"weight":2,"orderIndex":18},{"id":19,"text":"What's an absolute deal-breaker for you in a partner?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":3,"orderIndex":19},{"id":20,"text":"How do you show someone you love them on a day-to-day basis?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":20},{"id":21,"text":"What's your attachment style and how has it affected your relationships?","category":"relationships","answerType":"multiple_choice","options":["Secure - I feel comfortable with closeness","Anxious - I sometimes worry about being abandoned","Avoidant - I value independence highly","I'm not sure yet"],"isOnboardingQuestion":false,"weight":2,"orderIndex":21},{"id":22,"text":"How do you feel about staying friends with exes?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":22},{"id":23,"text":"What's the hardest conversation you've ever had to have with a partner?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":23},{"id":24,"text":"Do you believe in soulmates, or do you think love is a choice you make every day?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":24},{"id":25,"text":"How do you handle jealousy when it comes up?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":25},{"id":26,"text":"What role do your friends and family play in your romantic relationships?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":26},{"id":27,"text":"How long do you think you should date someone before getting serious?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":27},{"id":28,"text":"What's something a partner has done that made you feel truly seen?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":28},{"id":29,"text":"How important is physical affection to you in a relationship?","category":"relationships","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":29},{"id":30,"text":"What does trust look like once it's been broken - can it be rebuilt?","category":"relationships","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":3,"orderIndex":30},{"id":31,"text":"Describe your ideal weekend - are you out adventuring or recharging at home?","category":"lifestyle","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":2,"orderIndex":31},{"id":32,"text":"How important is physical fitness and health in your daily routine?","category":"lifestyle","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":32},{"id":33,"text":"Are you a morning person or a night owl?","category":"lifestyle","answerType":"multiple_choice","options":["Early bird - I love mornings","Night owl - I come alive after dark","Somewhere in between","It changes depending on the season"],"isOnboardingQuestion":false,"weight":1,"orderIndex":33},{"id":34,"text":"How do you feel about pets? Do you have any?","category":"lifestyle","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":34},{"id":35,"text":"What does your work-life balance look like right now, and is it where you want it?","category":"lifestyle","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":35},{"id":36,"text":"How do you like to spend money - are you a saver, spender, or somewhere in between?","category":"lifestyle","answerType":"multiple_choice","options":["Careful saver - I budget everything","Balanced - I save but enjoy treats","Spontaneous spender - life is short","Investor - I think long-term"],"isOnboardingQuestion":false,"weight":2,"orderIndex":36},{"id":37,"text":"How often do you drink alcohol or use other substances?","category":"lifestyle","answerType":"multiple_choice","options":["Never","Socially / occasionally","A few times a week","I prefer not to say"],"isOnboardingQuestion":false,"weight":2,"orderIndex":37},{"id":38,"text":"Do you see yourself living in a city, suburbs, or somewhere rural long-term?","category":"lifestyle","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":38},{"id":39,"text":"How important is keeping a clean and organized living space to you?","category":"lifestyle","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":39},{"id":40,"text":"What hobby or passion project are you most excited about right now?","category":"lifestyle","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":40},{"id":41,"text":"How do you feel about cooking? Do you meal-prep or order in?","category":"lifestyle","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":41},{"id":42,"text":"What does a typical weeknight look like for you after work?","category":"lifestyle","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":42},{"id":43,"text":"When something bothers you in a relationship, do you bring it up right away or sit with it first?","category":"communication","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":3,"orderIndex":43},{"id":44,"text":"How do you prefer to communicate - texting, calls, or face-to-face?","category":"communication","answerType":"multiple_choice","options":["Texting - I like to think before responding","Phone calls - I love hearing someone's voice","Face-to-face - nothing beats in-person","A mix of everything depending on the situation"],"isOnboardingQuestion":false,"weight":1,"orderIndex":44},{"id":45,"text":"What does healthy conflict look like to you?","category":"communication","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":3,"orderIndex":45},{"id":46,"text":"How do you react when someone gives you constructive criticism?","category":"communication","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":46},{"id":47,"text":"Do you tend to over-communicate or under-communicate in relationships?","category":"communication","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":47},{"id":48,"text":"How important is it that your partner checks in with you throughout the day?","category":"communication","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":48},{"id":49,"text":"When you're upset, do you need space or do you want to talk it out immediately?","category":"communication","answerType":"multiple_choice","options":["I need space to process first","I want to talk it out right away","It depends on what I'm upset about","I tend to shut down and need to be drawn out gently"],"isOnboardingQuestion":false,"weight":2,"orderIndex":49},{"id":50,"text":"How do you apologize when you've messed up?","category":"communication","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":50},{"id":51,"text":"What's a topic you find hard to talk about but know is important?","category":"communication","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":51},{"id":52,"text":"How do you feel about having difficult conversations over text versus in person?","category":"communication","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":52},{"id":53,"text":"How would your closest friend describe you in three words?","category":"personality","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":2,"orderIndex":53},{"id":54,"text":"What's a personality trait you're actively working on improving?","category":"personality","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":54},{"id":55,"text":"Are you more introverted or extroverted, and how does that show up in your relationships?","category":"personality","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":55},{"id":56,"text":"What's your biggest strength that you bring to a relationship?","category":"personality","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":56},{"id":57,"text":"What's a quirk about you that people either love or find confusing?","category":"personality","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":57},{"id":58,"text":"How do you handle stress - do you power through, take a break, or lean on others?","category":"personality","answerType":"multiple_choice","options":["Power through it alone","Take a break and recharge","Talk it out with someone I trust","Exercise or do something physical","A mix depending on the situation"],"isOnboardingQuestion":false,"weight":2,"orderIndex":58},{"id":59,"text":"What's something most people get wrong about you at first impression?","category":"personality","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":59},{"id":60,"text":"How competitive are you on a scale of 1-10?","category":"personality","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":60},{"id":61,"text":"Do you consider yourself more of a thinker or a feeler when making decisions?","category":"personality","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":61},{"id":62,"text":"What's the bravest thing you've ever done?","category":"personality","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":62},{"id":63,"text":"What makes you feel most loved and appreciated?","category":"emotions","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":3,"orderIndex":63},{"id":64,"text":"How comfortable are you with being vulnerable around a partner?","category":"emotions","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":3,"orderIndex":64},{"id":65,"text":"What emotion do you find hardest to express?","category":"emotions","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":65},{"id":66,"text":"When was the last time you cried, and what triggered it?","category":"emotions","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":66},{"id":67,"text":"How do you process grief or major disappointments?","category":"emotions","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":67},{"id":68,"text":"What's something that never fails to make you genuinely happy?","category":"emotions","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":68},{"id":69,"text":"How do you support a partner who's going through a tough time?","category":"emotions","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":69},{"id":70,"text":"Do you tend to hold grudges or forgive quickly?","category":"emotions","answerType":"multiple_choice","options":["I forgive quickly and move on","I forgive but I don't forget","It takes me a while to let things go","It depends on how deep the hurt was"],"isOnboardingQuestion":false,"weight":2,"orderIndex":70},{"id":71,"text":"What's your emotional love language?","category":"emotions","answerType":"multiple_choice","options":["Words of affirmation","Acts of service","Receiving gifts","Quality time","Physical touch"],"isOnboardingQuestion":true,"weight":3,"orderIndex":71},{"id":72,"text":"How do you recharge emotionally after a draining week?","category":"emotions","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":72},{"id":73,"text":"Where do you see yourself in five years, and does that picture include a partner?","category":"goals","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":3,"orderIndex":73},{"id":74,"text":"Do you want kids someday, and if so, what kind of parent do you want to be?","category":"goals","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":3,"orderIndex":74},{"id":75,"text":"What's a personal goal you're currently chasing?","category":"goals","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":75},{"id":76,"text":"How ambitious are you when it comes to your career?","category":"goals","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":76},{"id":77,"text":"What's something you want to accomplish before you turn 50?","category":"goals","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":77},{"id":78,"text":"How do you feel about a partner who's more or less ambitious than you?","category":"goals","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":78},{"id":79,"text":"What does financial stability look like to you?","category":"goals","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":79},{"id":80,"text":"If money weren't a factor, what would you spend your life doing?","category":"goals","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":80},{"id":81,"text":"What three qualities are non-negotiable in a partner for you?","category":"compatibility","answerType":"text","options":null,"isOnboardingQuestion":true,"weight":3,"orderIndex":81},{"id":82,"text":"How important is intellectual compatibility to you?","category":"compatibility","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":82},{"id":83,"text":"Do you prefer someone with similar interests or someone who introduces you to new things?","category":"compatibility","answerType":"multiple_choice","options":["Similar interests - shared hobbies bring us closer","Different interests - I love learning new things","A healthy mix of both","It doesn't really matter to me"],"isOnboardingQuestion":false,"weight":1,"orderIndex":83},{"id":84,"text":"How important is physical attraction versus emotional connection for you?","category":"compatibility","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":84},{"id":85,"text":"What's your ideal way to handle finances as a couple?","category":"compatibility","answerType":"multiple_choice","options":["Fully combined - what's mine is yours","Partially combined - shared account for bills, separate for personal","Completely separate - we split everything","Flexible - depends on the situation"],"isOnboardingQuestion":false,"weight":2,"orderIndex":85},{"id":86,"text":"How important is it that your partner gets along with your family?","category":"compatibility","answerType":"rating","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":86},{"id":87,"text":"What's your stance on sharing passwords and phone access in a relationship?","category":"compatibility","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":87},{"id":88,"text":"How do you feel about long-distance relationships?","category":"compatibility","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":88},{"id":89,"text":"What role should humor play in a relationship?","category":"compatibility","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":89},{"id":90,"text":"How do you feel about your partner having close friends of the gender they're attracted to?","category":"compatibility","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":90},{"id":91,"text":"If you could live anywhere in the world for a year, where would you go and why?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":91},{"id":92,"text":"What's the best meal you've ever had, and what made it so special?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":92},{"id":93,"text":"What's your go-to karaoke song, guilty pleasure show, or comfort movie?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":93},{"id":94,"text":"If we went on a first date, what would your ideal plan be?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":2,"orderIndex":94},{"id":95,"text":"What's the most spontaneous thing you've ever done?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":95},{"id":96,"text":"What kind of traveler are you?","category":"fun","answerType":"multiple_choice","options":["Planner - itinerary for every day","Go with the flow - no plans needed","Adventure seeker - off the beaten path","Relaxation focused - beach and spa","Culture explorer - museums and local food"],"isOnboardingQuestion":false,"weight":1,"orderIndex":96},{"id":97,"text":"What's a skill you've always wanted to learn but haven't yet?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":97},{"id":98,"text":"What does a perfect lazy Sunday look like with a partner?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":98},{"id":99,"text":"If you could have dinner with anyone - living or dead - who would it be and what would you ask?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":99},{"id":100,"text":"What's the weirdest hill you'll die on?","category":"fun","answerType":"text","options":null,"isOnboardingQuestion":false,"weight":1,"orderIndex":100}],"answeredIds":[],"totalAnswered":0,"total":100}
