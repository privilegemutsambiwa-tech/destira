<?xml version="1.0" encoding="utf-8"?>
<!-- The Destira mark as a vector, so the launch screen is sharp on every
     phone. Same geometry as client/public/brand/destira-icon.svg; sized to
     sit inside Android 12's launch-icon circle (the middle 72 of 108). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="6"
        android:translateY="18">
        <group
            android:rotation="-15"
            android:pivotX="80"
            android:pivotY="60">
            <path
                android:pathData="M62,60a34,34 0,1 0,68,0a34,34 0,1 0,-68,0"
                android:strokeColor="#8FE3C7"
                android:strokeWidth="6" />
            <path
                android:pathData="M30,60a34,34 0,1 0,68,0a34,34 0,1 0,-68,0"
                android:strokeColor="#FF6B4A"
                android:strokeWidth="6" />
            <group>
                <clip-path android:pathData="M62,60a34,34 0,1 0,68,0a34,34 0,1 0,-68,0" />
                <path
                    android:pathData="M30,60a34,34 0,1 0,68,0a34,34 0,1 0,-68,0"
                    android:fillColor="#1A1418" />
            </group>
        </group>
    </group>
</vector>
